        "from sklearn.metrics import jaccard_score\n",
        "import numpy as np\n",
        "\n",
        "# ground_truth = your expert mask (binary array)\n",
        "# otsu_pred = your Otsu output (binary array)\n",
        "\n",
        "# Example definitions for demonstration\n",
        "ground_truth = np.array([[0, 1, 0], [1, 1, 0], [0, 0, 1]])\n",
        "otsu_pred = np.array([[0, 1, 1], [1, 0, 0], [0, 0, 1]])\n",
        "\n",
        "intersection = np.logical_and(ground_truth, otsu_pred).sum()\n",
        "union = np.logical_or(ground_truth, otsu_pred).sum()\n",
        "tp = intersection\n",
        "fp = otsu_pred.sum() - tp\n",
        "fn = ground_truth.sum() - tp\n",
        "\n",
        "dice = 2*tp / (2*tp + fp + fn)\n",
        "jaccard = tp / (tp + fp + fn)\n",
        "print(f\"Dice: {dice:.3f}, Jaccard: {jaccard:.3f}\")"
      ]
